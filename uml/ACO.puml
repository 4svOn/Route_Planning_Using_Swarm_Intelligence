@startuml ACO_Component_Class_Diagram

title ACO Component Class Diagram

skinparam nodesep 90
skinparam ranksep 100
skinparam linetype ortho
' top to bottom direction
set separator none

namespace SI::ACO {

    class TParameters {
        +PheromonceImportance: = 1.0
        +DistanceImportance = 5.0
        +EvaporateRate = 0.01
        +ProbabalisticBorder = 0.5
        +AntsPerIteration = 50
        +MaxIterations = 5000
        +MaxIterationsWithoutImprovement = 500
    }

    class TSolver {
        +TSolver(CVRP::TProblem, TParameters)
        +CVRP::TSolution Solve()
        +GetBestDistance()
        -InitializePheromones()
        -EvaporatePheromones(TAnt)
        -DepositPheromones(TAnt)
        -CVRP::TProblem Problem
        -TParameters Parameters
        -std::vector<TAnt> Ants
        -TPheromoneMatrix Pheromones
        -TDistance BestDistance
        -int64_t BestAntIndex
    }

    class TAnt {
        +TAnt(CVRP::TProblem)
        +Reset()
        +TotalDistance()
        +GetRoutes()
        +ConructSolution(TParameters, TPheromoneMatrix)
        +MakeTwoOpt()
        -VisitCustomer(CVRP::TNode)
        -ReturnToDepot()
        -SelectNextCustomer(..)
        -CVRP::TProblem Problem
        -CVRP::TRoutes Routes
        -CVRP::TNodesSet VisitedCustomers
        -CVRP::TNodesSet UnvisitedCustomers
        -int64_t RemainingCapacity_
    }

    class TPheromoneMatrix << (T,#FF7700) >> {
        ..std::vector<std::vector<double>>..
    }
}

