' Explicit class-to-class relationships
TSolver "1" *-right- "1" TParameters : uses >
TSolver "1" *-- "1..*" TAnt : manages >
' TSolver *-[hidden]-  TPheromoneMatrix
' TSolver *-[hidden]-  TPheromoneMatrix
TSolver "1" *-- "1" TPheromoneMatrix : maintains >

' SI.ACO.TSolver --> SI.CVRP.TProblem : contains >
' SI.ACO.TAnt --> SI.CVRP.TProblem : references >

' SI.ACO.TSolver --> SI.CVRP.TSolution : produces >
' SI.ACO.TAnt --> SI.CVRP.TNode : visits >
' SI.ACO.TAnt --> SI.CVRP.TRoutes : builds >

' TSolver -[hidden]-> TAnt
' TSolver -[hidden]-> TAnt
' TSolver --> TAnt : calls ConstructSolution()

@enduml